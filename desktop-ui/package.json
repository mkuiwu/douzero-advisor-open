{
  "name": "douzero-advisor-desktop-ui",
  "version": "0.1.0",
  "private": true,
  "description": "DouZero Advisor Electron desktop shell",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:java-ws": "tsx scripts/java-ws-integration.ts",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "typecheck": "vue-tsc --noEmit -p src/renderer/tsconfig.json && tsc --noEmit -p src/main/tsconfig.json && tsc --noEmit -p src/preload/tsconfig.json",
    "package:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.5",
    "vue": "^3.5.42",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.0"
  },
  "build": {
    "appId": "com.mkuiwu.douzero.advisor",
    "productName": "DouZero Advisor",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
